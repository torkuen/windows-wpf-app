<Window x:Class="MSProjectParser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MSProjectParser"
        xmlns:viewModels="clr-namespace:MSProjectParser.ViewModels"
        mc:Ignorable="d"
        Title="MS Project Parser" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <TextBlock Text="{Binding ProjectName}" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- TreeView Container -->
        <Border Grid.Row="1" Margin="10" BorderBrush="#BDC3C7" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TreeView ItemsSource="{Binding Tasks}" 
                          Background="White"
                          BorderThickness="0">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                            <Setter Property="Margin" Value="0,2"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Border BorderBrush="#E0E0E0" 
                                    BorderThickness="0,0,0,1" 
                                    Padding="5"
                                    Margin="0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Task Name -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="📋" Margin="0,0,5,0" FontSize="14"/>
                                        <TextBlock Text="{Binding Name}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Start Date -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Start: " 
                                                   Foreground="Gray" 
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Start, StringFormat='{}{0:MM/dd/yyyy}'}" 
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Finish Date -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="Finish: " 
                                                   Foreground="Gray" 
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Finish, StringFormat='{}{0:MM/dd/yyyy}'}" 
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Duration -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <TextBlock Text="⏱ " 
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Duration}" 
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Progress Bar -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                        <ProgressBar Value="{Binding PercentComplete}" 
                                                     Width="80" 
                                                     Height="20" 
                                                     Minimum="0" 
                                                     Maximum="100"
                                                     Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding PercentComplete, StringFormat='{}{0}%'}" 
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PercentComplete}" Value="100">
                                                            <Setter Property="Foreground" Value="Green"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PercentComplete}" Value="0">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#ECF0F1" Padding="10">
            <TextBlock Text="MS Project XML Parser - Hierarchical Task View" 
                       FontSize="12" 
                       Foreground="#7F8C8D"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
